{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-edge-tlm/docs/research/schemas/claim-ledger.schema.json",
  "title": "AI Edge TLM claim ledger",
  "type": "object",
  "required": [
    "schema",
    "as_of_date",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "ai-edge-tlm/claim-ledger/v1"
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "source_ids",
          "evidence_ceiling",
          "decision",
          "falsifier",
          "implementation_state"
        ]
      }
    }
  }
}
